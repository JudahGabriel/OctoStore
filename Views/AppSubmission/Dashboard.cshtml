@model List<OctoStore.Models.DashboardRepositoryInfo>
@using OctoStore.Models

@{
    var userName = Context.User.FindFirst(System.Security.Claims.ClaimTypes.Name)?.Value ?? "Unknown";
}

<!DOCTYPE html>
<html lang="en" dir="ltr">

<head>
    <meta charset="utf-8" />
    <title>OctoStore - Publish your open source app to the Microsoft Store</title>
    <base href="/" />

    <meta name="description" content="Dashboard showing your GitHub repositories and their Microsoft Store submission status">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <link rel="stylesheet" href="https://early.webawesome.com/webawesome@3.0.0-beta.3/dist/styles/webawesome.css" />
    <script type="module" src="https://early.webawesome.com/webawesome@3.0.0-beta.3/dist/webawesome.loader.js"></script>
    <link rel="stylesheet" href="~/css/dashboard.css" />
</head>

<body>
    <div class="container">
        <div class="header">
            <div>
                <h1 class="dashboard-title">Publish your open source app to the Microsoft Store</h1>
                <p class="dashboard-subtitle">
                    Manage your GitHub repositories and Microsoft Store submissions
                </p>
            </div>
            <div class="user-info">
                @if (Context.User.FindFirst("avatar_url")?.Value != null)
                {
                    <img src="@Context.User.FindFirst("avatar_url")?.Value" alt="@userName" class="user-avatar" />
                }
                <div>
                    <div class="user-name">@userName</div>
                    <div class="user-repo-count">@Model.Count repositories</div>
                </div>
                <a href="/auth/logout" class="logout-btn">Sign Out</a>
            </div>
        </div>

        @if (Model.Count == 0)
        {
            <wa-card>
                <div class="empty-state">
                    <wa-icon name="inbox" class="empty-state-icon"></wa-icon>
                    <h3 class="empty-state-title">No repositories found</h3>
                    <p class="empty-state-description">
                        Make sure you have repositories on GitHub to see them here.
                    </p>
                </div>
            </wa-card>
        }
        else
        {
            <div class="repo-grid">
                @foreach (var repoInfo in Model.OrderByDescending(r => r.AppSubmission != null))
                {
                    @await Html.PartialAsync("_RepoCard", repoInfo)
                }
            </div>
        }
    </div>
</body>
</html>